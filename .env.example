# Docker Compose reads this file; direct CLI users export variables in the shell.
AGENTOS_API_TOKEN=replace-with-your-own-random-token-at-least-16-characters
AGENTOS_ALLOWED_HOSTS=localhost,127.0.0.1
AGENTOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
AGENTOS_PLANNER=local
# Optional AI: choose a model available to your account with Responses structured-output support.
OPENAI_API_KEY=
AGENTOS_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENTOS_AI_TIMEOUT=20
